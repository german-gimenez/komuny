# =====================================================================
# Komuny Chat (.env) - Variables para Railway deployment
# =====================================================================
# Copiar estas variables al servicio LibreChat en Railway → Variables
# Doc oficial: https://www.librechat.ai/docs/configuration/dotenv
# =====================================================================

# =====================================================================
# Server
# =====================================================================
HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=https://chat.komuny.org
DOMAIN_SERVER=https://chat.komuny.org
NO_INDEX=false
TRUST_PROXY=1

# =====================================================================
# MongoDB (Railway lo crea automaticamente, ya viene seteado)
# =====================================================================
# MONGO_URI=mongodb://mongo:27017/LibreChat  ← Railway lo inyecta solo

# =====================================================================
# Logging
# =====================================================================
DEBUG_LOGGING=true
DEBUG_CONSOLE=false
CONSOLE_JSON=true

# =====================================================================
# Branding Komuny
# =====================================================================
APP_TITLE=Komuny Chat
# CUSTOM_FOOTER soporta markdown — incluye link a napsix.ai/komuny
CUSTOM_FOOTER=[Komuny Edu](https://komuny.org) · Built with [Anthropic](https://anthropic.com) · Desarrollado por [Napsix.AI](https://napsix.ai/komuny)
HELP_AND_FAQ_URL=https://komuny.org/fundacion

# =====================================================================
# Endpoints - Anthropic Claude (Komuny paga, educadores no necesitan key)
# =====================================================================
# Los presets del librechat.yaml usan claude-haiku-4-5 (5 presets) y
# claude-sonnet-4-6 (Detector de Sesgos). Costo aprox por usuario activo
# (10 conversaciones/mes): ~$0.05-0.30 USD.

ANTHROPIC_API_KEY=sk-ant-api03-CHANGEME    # OBTENER en console.anthropic.com
# OPENAI_API_KEY=user_provided             # Activar si quieres dar opcion GPT
# GOOGLE_KEY=user_provided                 # Activar para Gemini opcional

# =====================================================================
# RAG (uploads + busqueda semantica en documentos)
# =====================================================================
# Genera embeddings de PDFs/textos subidos por el docente
RAG_API_URL=http://rag_api:8000
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
RAG_OPENAI_API_KEY=changeme_openai_key_for_embeddings_only

# =====================================================================
# Crypto - REGENERAR para tu instancia (NO USAR ESTOS VALORES)
# =====================================================================
# Generar nuevos: openssl rand -hex 32  (Linux/Mac)
#                 [System.BitConverter]::ToString((New-Object byte[] 32 | %{ Get-Random -Maximum 256 }))  (PowerShell)
# IMPORTANTE: cambiar antes de deploy productivo
JWT_SECRET=REGENERATE_THIS_VALUE_USING_openssl_rand_hex_32
JWT_REFRESH_SECRET=REGENERATE_THIS_VALUE_USING_openssl_rand_hex_32
CREDS_KEY=REGENERATE_THIS_VALUE_USING_openssl_rand_hex_32
CREDS_IV=REGENERATE_THIS_VALUE_USING_openssl_rand_hex_16
SESSION_EXPIRY=900000
REFRESH_TOKEN_EXPIRY=604800000

# =====================================================================
# Auth - email + Google
# =====================================================================
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
ALLOW_PASSWORD_RESET=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=false

# Google OAuth (crear en https://console.cloud.google.com)
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_CALLBACK_URL=/oauth/google/callback

# =====================================================================
# Search (Meilisearch para buscar en conversaciones)
# =====================================================================
SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://meilisearch:7700
# Railway inyecta MEILI_MASTER_KEY automaticamente

# =====================================================================
# Moderacion y rate limits (proteccion contra abuso)
# =====================================================================
BAN_VIOLATIONS=true
BAN_DURATION=7200000
BAN_INTERVAL=20

LOGIN_MAX=10
LOGIN_WINDOW=5
REGISTER_MAX=5
REGISTER_WINDOW=60

LIMIT_CONCURRENT_MESSAGES=true
CONCURRENT_MESSAGE_MAX=3

LIMIT_MESSAGE_IP=true
MESSAGE_IP_MAX=60
MESSAGE_IP_WINDOW=1

LIMIT_MESSAGE_USER=true
MESSAGE_USER_MAX=120
MESSAGE_USER_WINDOW=1

# =====================================================================
# Balance / Token tracking (opcional - activar si quieres limitar uso)
# =====================================================================
# CHECK_BALANCE=true
# START_BALANCE=20000

# =====================================================================
# Email (password reset) - configurar despues de tener dominio
# =====================================================================
# Recomendado: Resend (https://resend.com) - 100 emails/dia gratis
# EMAIL_SERVICE=Resend
# EMAIL_USERNAME=resend
# EMAIL_PASSWORD=re_xxxxxxxxxxxx
# EMAIL_FROM=hola@komuny.org
# EMAIL_FROM_NAME=Komuny Chat

# =====================================================================
# Compartir conversaciones (util para que docentes compartan prompts)
# =====================================================================
ALLOW_SHARED_LINKS=true
ALLOW_SHARED_LINKS_PUBLIC=true

# =====================================================================
# Node config
# =====================================================================
NODE_ENV=production
NODE_MAX_OLD_SPACE_SIZE=4096

# =====================================================================
# Path al librechat.yaml (Railway monta el archivo desde el repo)
# =====================================================================
# Si pusiste el yaml en el root del proyecto, no hace falta esta var.
# CONFIG_PATH=/app/librechat.yaml
